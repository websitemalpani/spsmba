NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL connection string. On Hostinger (or any shared MySQL host), create a
# database + user in hPanel and use the values it gives you here, e.g.:
# mysql://u123_dbuser:password@localhost:3306/u123_spsmba
DATABASE_URL=mysql://user:password@localhost:3306/sps_mba

# Signs the admin login session cookie — set this to a long random string
# (e.g. `openssl rand -hex 32`) and keep it secret.
SESSION_SECRET=change-this-to-a-long-random-string

# Used once by `npm run db:seed` to create the first admin login. Change the
# password afterwards from inside /admin, or just re-seed with a new value.
ADMIN_EMAIL=admin@spsmba.edu.in
ADMIN_PASSWORD=change-this-password
